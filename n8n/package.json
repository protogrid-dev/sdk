{
	"name": "@protogrid/n8n-nodes-protogrid",
	"version": "0.1.1",
	"description": "n8n node for the protogrid MCP registry: find MCP servers by what they do, check them against your rules, and get the connection for the MCP Client Tool.",
	"license": "MIT",
	"homepage": "https://docs.protogrid.dev/sdk/n8n/",
	"keywords": [
		"n8n-community-node-package",
		"mcp",
		"model-context-protocol",
		"agents",
		"protogrid"
	],
	"author": {
		"name": "protogrid",
		"email": "hello@protogrid.dev"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/protogrid-dev/sdk.git",
		"directory": "n8n"
	},
	"bugs": {
		"url": "https://github.com/protogrid-dev/sdk/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"typecheck": "tsc --noEmit"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/ProtogridApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Protogrid/Protogrid.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.58.5",
		"eslint": "9.32.0",
		"n8n-workflow": "^2.49.3",
		"typescript": "5.9.2",
		"vitest": "^5.0.1"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"publishConfig": {
		"access": "public"
	}
}
