{
  "name": "protogridctl",
  "version": "0.1.0",
  "description": "Add MCP servers to Cursor, VS Code, Claude Code, Claude Desktop, Gemini CLI, Codex, opencode and Goose from the protogrid registry, checked before they are installed.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "protogridctl": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": ["mcp", "model-context-protocol", "mcp-server", "cursor", "vscode", "claude", "cli", "installer"],
  "homepage": "https://docs.protogrid.dev/guides/install-cli/",
  "repository": { "type": "git", "url": "git+https://github.com/protogrid-dev/sdk.git", "directory": "cli" },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "prepublishOnly": "pnpm run build"
  }
}
