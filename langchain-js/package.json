{
  "name": "@protogrid/langchain",
  "version": "0.1.0",
  "description": "LangChain.js tools from the protogrid MCP registry: find MCP servers by what they do, check them against your rules, and give your agent the tools of the ones that pass.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "@protogrid/sdk": "^0.6.0"
  },
  "peerDependencies": {
    "@langchain/core": "^1.5.0"
  },
  "devDependencies": {
    "@langchain/core": "^1.5.1",
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "langchain": "^1.6.8",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/protogrid-dev/sdk.git",
    "directory": "langchain-js"
  },
  "homepage": "https://docs.protogrid.dev/sdk/langchain-js/",
  "bugs": {
    "url": "https://github.com/protogrid-dev/sdk/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "langchain",
    "langchainjs",
    "agents",
    "tools",
    "protogrid"
  ],
  "publishConfig": {
    "access": "public"
  }
}
